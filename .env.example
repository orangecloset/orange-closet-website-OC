# ---------------------------------------------------------------------------
# Server-only secrets (used by Cloudflare Workers).
# Set these via `wrangler secret put <NAME>` — never commit real values.
# Do NOT prefix these with VITE_ and never import them into client code.
# ---------------------------------------------------------------------------

# Neon Postgres connection string (Settings > Connection Details in Neon dashboard)
DATABASE_URL=

# ---------------------------------------------------------------------------
# Cloudinary
# ---------------------------------------------------------------------------

# Cloud name (found on the Cloudinary dashboard home). Safe to be semi-public,
# but we keep it server-side and store full image URLs in the database instead.
CLOUDINARY_CLOUD_NAME=

# API key + secret (Dashboard > Settings > Access Keys) — used for signed uploads
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Shared secret the CMS sends with write requests (x-cms-secret header).
# Temporary gate until real accounts exist. Generate e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CMS_API_SECRET=

# Protects the weekly Cloudinary cleanup cron (/api/cron/cloudinary-gc).
# The endpoint refuses to run without it.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Client-visible variables (VITE_ prefix = bundled into the browser build,
# NEVER put secrets here)
# ---------------------------------------------------------------------------

# Neon Auth — Managed Better Auth base URL (Neon Console → Auth → Configuration).
# When set, the admin uses real email/password sign-in instead of the shared
# password. The first account to sign in becomes the super admin.
VITE_NEON_AUTH_URL=

# Cloudinary cloud name — server-side fallback for signed uploads
# (src/routes/upload.ts reads this if CLOUDINARY_CLOUD_NAME isn't set).
# Public by design; the API key/secret stay server-side above.
VITE_CLOUDINARY_CLOUD_NAME=
